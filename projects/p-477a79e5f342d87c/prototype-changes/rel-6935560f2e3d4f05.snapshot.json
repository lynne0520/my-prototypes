["data:image/svg+xml"]},"styles/prd-viewer.css":{"bytes":17872,"hash":"88b7ec5f1d5b7bf1a2d5ccf9a48574337f1aee07","kind":"style","refs":[]},"styles/tokens.css":{"bytes":8028,"hash":"a7b4ee3d8490b3c84929b4680b0ca969409bfae2","kind":"style","refs":[]},"高三34班_跨学科分析报表_最近批改.html":{"bytes":7044,"hash":"cc9815bcfc0a5f119394cd7f69c125e9b76d84a4d7e60cb573cd9f2886aec6bc","kind":"html","logicHash":"5f058d859de27de36ebd323050a40fc5c76dd32e83a7481016a69b348080a467","nodes":{"html:nth-of-type(1) > body:nth-of-type(1) > div:nth-of-type(1) > header:nth-of-type(1) > h1:nth-of-type(1)":{"anchor":{"selector":"html:nth-of-type(1) > body:nth-of-type(1) > div:nth-of-type(1) > header:nth-of-type(1) > h1:nth-of-type(1)","tag":"h1","text":"高三34班 · 跨学科分析诊断报表 当日诊断 · 2026-11-05"},"scope":"","stable":false,"state":"","text":"高三34班 · 跨学科分析诊断报表 当日诊断 · 2026-11-05"},"html:nth-of-type(1) > body:nth-of-type(1) > div:nth-of-type(1) > header:nth-of-type(1) > p:nth-of-type(1)":{"anchor":{"selector":"html:nth-of-type(1) > body:nth-of-type(1) > div:nth-of-type(1) > header:nth-of-type(1) > p:nth-of-type(1)","tag":"p"},"scope":"","stable":false,"state":"","text":"班级：高三34班（物化生） · 学年：2026-2027学年 · 有效人数：37 人 · 数据来源：新教育平台学情分析（作业批改） 数据口径：2026-11-05 当日已批改作业（9 份 / 6 学科），同一学科多份作业无主次，学科得分率 = 该科所有作业得分合计 ÷ 满分合计（满分大的作业占比重大）；学科组得分率按同一套作业、同一权重计算。生成时间：2026-11-05 22:10"},"html:nth-of-type(1) > body:nth-of-type(1) > div:nth-of-type(1) > p:nth-of-type(1)":{"anchor":{"selector":"html:nth-of-type(1) > body:nth-of-type(1) > div:nth-of-type(1) > p:nth-of-type(1)","tag":"p"},"scope":"","stable":false,"state":"","text":"使用说明：本表是「阶段学情分诊」而非长期特质判断——班级侧只列明确短板、相对短板学科，学生侧给出个人补弱方向。本独立报表示例使用未修改时的常规默认规则；主页面支持按教师、按学科调整。 班级怎么判弱科= 两条通道任一命中即判明确短板：某科班均未达 85%，且最近两次作业都比同卷学科组低至少 5 个百分点； 或全班得分率不到 60% 的学生占比 ≥30%。命中的学科全部列出，只出现一次或只有 1 份作业时标「短板待确认」。 班均未达 85%、低于学科组但未达明确短板条件的科目列为相对短板，与明确短板分组同时展示；某科未交超 30% 先抓提交，不判学科强弱。 术语说明：「明确短板」表示当前作业证据已达到设定阈值，属于阶段性学科表现判断，不代表班级或学生能力定型；「相对短板」的参照为同卷学科组。 学生怎么定补哪一科= 每名有有效成绩的学生都必须有一科个人补弱方向：该生这一科得分率未达 85% 且比班均低 10 个百分点以上， 或得分率直接不到 60% 时，列为重点提升；没有过线学科时，按「（个人 − 班均）÷ 10 个百分点」选出相对最弱的一科。 「优先巩固」只表示个人学习优先级，可能仍高于班均，不等同于薄弱学科；只有 1 份作业时结论暂定。 证据与时效：按该科有效作业份数看，3 份以上结论最稳、2 份次之、只有 1 份时仅给临时建议； 自动排序只用当日或近 3 天的作业，更早的数据仅作趋势参考。 满分区（该科学生得分率 75 分位已达 95%）只作提示，不再跳过判定； 因相对判弱要求本人得分率未达 85%，高分小分差通常不会触发，但其中仍有学生得分率不到 60% 时，照常进个人建议。 缺交 / 未批改显示「—」，不按 0 分参与均分与能力判定。 阈值说明：本页的 85% / 60% / 10pp / 5pp / 30% 均为常规默认值，也是暂无教研校准时的暂行保守值；主页面修改后…"},"html:nth-of-type(1) > body:nth-of-type(1) > div:nth-of-type(1) > p:nth-of-type(2)":{"anchor":{"selector":"html:nth-of-type(1) > body:nth-of-type(1) > div:nth-of-type(1) > p:nth-of-type(2)","tag":"p"},"scope":"","stable":false,"state":"","text":"本报表含学生姓名与学号，仅限校内使用，请勿外传。同一学科若当日存在多份作业，作业之间无主次， 学科得分率 = 该科所有作业得分合计 ÷ 满分合计（按满分加权：语文 2 份满分 40 与 20，权重 40 : 20，不再等权）； 学科组得分率按同一套作业、同一权重计算，改筛选时班级侧与学科组侧同步重算。 逐作业得分率当前为演示数据（由学科基准率拆分得出），非真实观测。"}},"refs":["styles/tokens.css","styles/app.css","js/focus-data.js"],"structureHash":"26b2f0c73f31f9a0af958aee6cbf0b4b68693ea1261be8701a49fe26a2b283b3","styleHash":"938ea29ca2ea89e80742ecd9609570f01a0616d133e9efa1fc4727a09ba293bd","textRules":[]}},"mode":"review","name":"学科侧重表","navigation":{},"pages":[{"file":"index.html","id":"home","states":[{"id":"default","kind":"default","title":"默认页面"}],"title":"演示学校 · 学情分析 · 班级报告（作业）"},{"file":"高三34班_跨学科分析报表_最近批改.html","id":"高三34班_学科侧重报表_最近批改","states":[{"id":"default","kind":"default","title":"默认页面"}],"title":"高三34班跨学科分析报表（最近批改）"}],"projectId":"p-477a79e5f342d87c","runtime":"1cbd04de679ab2813cb381260f6548552ff77343c9c1149cdf5c26bc0fd9430c","schemaVersion":1}